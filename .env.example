# ANUBIS — Environment Variables

# Required for authenticated API endpoints. Generate a unique random secret
# of at least 32 characters. The application does not provide a default key.
ANUBIS_API_KEY=

# Optional separate demo credential. If set, it must also be at least 32 chars.
ANUBIS_DEMO_KEY=

# Optional comma-separated browser origin allowlist. Empty means no CORS origins.
ANUBIS_CORS_ORIGINS=

# Engine and local audit database
ANUBIS_ENGINE_PRESET=industrial_strict
ANUBIS_DB_PATH=anubis_audit.db

# Local development server
PORT=8000
